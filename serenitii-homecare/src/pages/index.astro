    <main>
      <!-- Hero Section -->
      <section class="relative pt-12 pb-16 md:py-20 overflow-hidden">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="grid lg:grid-cols-12 gap-12 items-center">
            
            <div class="lg:col-span-7">
