---
import '../styles/global.css';

// Serenitii Loving Homecare LLC - Tier 01 Local Landing Page
const FORMSPREE_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "HomeHealthService",
  "name": "Serenitii Loving Homecare LLC",
  "telephone": "+1-317-796-1078",
  "email": "SerenitiiLovingHomecare@yahoo.com",
  "description": "Compassionate, non-medical in-home care services across Indiana, specializing in personal care, meal preparation, medication reminders, and companionship. Accepting private pay and Medicaid.",
  "areaServed": [
    {
      "@type": "City",
      "name": "Indianapolis",
      "sameAs": "https://en.wikipedia.org/wiki/Indianapolis"
    },
    {
      "@type": "City",
      "name": "Evansville",
      "sameAs": "https://en.wikipedia.org/wiki/Evansville,_Indiana"
    },
    {
      "@type": "State",
      "name": "Indiana"
    }
  ],
  "paymentAccepted": ["Medicaid", "Cash", "Credit Card", "Private Pay"],
  "currenciesAccepted": "USD",
  "priceRange": "$$"
};
