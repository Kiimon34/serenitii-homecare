            </div>
          </div>
        </div>
      </section>

      <!-- 3-Step How It Works Section -->
      <section id="how-it-works" class="py-20 bg-[#FAF9F6]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-xs font-bold uppercase tracking-widest text-sky-800">Clear & Transparent Process</span>
            <h2 class="text-3xl sm:text-4xl font-serif font-bold text-slate-950 mt-2">
              How We Start Care In 3 Steps
