          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Service 1 -->
            <div class="bg-[#FAF9F6] p-6 rounded-2xl border border-slate-200 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center mb-5">
