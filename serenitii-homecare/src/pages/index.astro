                </p>
              </div>
              <span class="mt-6 inline-block text-xs font-bold text-slate-400 uppercase tracking-wider">Nutrition</span>
            </div>

            <!-- Service 3 -->
            <div class="bg-[#FAF9F6] p-6 rounded-2xl border border-slate-200 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-900 flex items-center justify-center mb-5">
                  <svg class="w-6 h-6 text-emerald-800" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
