                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-amber-400 flex-shrink-0" width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span>Rapid onboarding for immediate home placement</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact & Formspree Form Section -->
      <section id="contact" class="py-20 md:py-28">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="grid lg:grid-cols-12 gap-12">
            
            <div class="lg:col-span-5">
              <span class="text-xs font-bold uppercase tracking-wider text-sky-800">Contact Us Now</span>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold text-slate-950 mt-2 mb-6">
                Let's discuss how we can help your family.
              </h2>
              <p class="text-slate-600 mb-8 leading-relaxed">
                Reach out by phone or submit the request form. We review each intake promptly to match you with dependable in-home caregivers.
              </p>

              <div class="space-y-6">
                <!-- Phone -->
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center text-amber-900 flex-shrink-0">
                    <svg class="w-5 h-5 text-amber-900" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Phone</p>
                    <a href="tel:3177961078" class="text-lg font-bold text-slate-900 hover:text-sky-800 transition">
                      (317) 796-1078
                    </a>
                  </div>
                </div>

                <!-- Email -->
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-sky-100 flex items-center justify-center text-sky-900 flex-shrink-0">
                    <svg class="w-5 h-5 text-sky-900" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Email</p>
                    <a href="mailto:SerenitiiLovingHomecare@yahoo.com" class="text-sm sm:text-base font-bold text-slate-900 hover:text-sky-800 transition break-all">
                      SerenitiiLovingHomecare@yahoo.com
                    </a>
                  </div>
                </div>

                <!-- Service Radius -->
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-900 flex-shrink-0">
                    <svg class="w-5 h-5 text-emerald-900" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Service Areas</p>
                    <p class="text-base font-bold text-slate-900">Evansville, & Indianapolis, Indiana</p>
                    <p class="text-xs text-slate-500">Providing non-medical care state wide</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Formspree Contact Form -->
            <div class="lg:col-span-7">
              <form
                action={FORMSPREE_ENDPOINT}
                method="POST"
                class="bg-white p-7 sm:p-10 rounded-3xl border border-slate-200 shadow-lg"
              >
                <h3 class="text-xl font-bold text-slate-900 mb-6 font-serif">Inquiry & Intake Form</h3>

                <div class="grid sm:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Name *</label>
                    <input
                      type="text"
                      name="name"
                      id="name"
                      required
                      placeholder="Jane Doe"
                      class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition text-sm text-slate-900 bg-slate-50 focus:bg-white"
                    />
                  </div>
                  <div>
                    <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Phone Number *</label>
                    <input
                      type="tel"
                      name="phone"
                      id="phone"
                      required
                      placeholder="(317) 000-0000"
                      class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition text-sm text-slate-900 bg-slate-50 focus:bg-white"
                    />
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email Address</label>
                    <input
                      type="email"
                      name="email"
                      id="email"
                      placeholder="name@email.com"
                      class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition text-sm text-slate-900 bg-slate-50 focus:bg-white"
                    />
                  </div>
                  <div>
                    <label for="location" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">City or County</label>
                    <input
                      type="text"
                      name="location"
                      id="location"
                      placeholder="e.g., Indianapolis or Evansville"
                      class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition text-sm text-slate-900 bg-slate-50 focus:bg-white"
                    />
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label for="service_needed" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Primary Care Needed</label>
                    <select
                      name="service_needed"
                      id="service_needed"
                      class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition text-sm text-slate-900 bg-slate-50 focus:bg-white"
                    >
                      <option value="Personal Care">Personal Care (Bathing, Dressing, Mobility)</option>
                      <option value="Meal Preparation">Meal Preparation</option>
                      <option value="Medication Reminder">Medication Reminder</option>
                      <option value="Companionship">Companionship</option>
                      <option value="Multiple Services">Multiple Services / Full Assessment</option>
                    </select>
                  </div>
                  <div>
                    <label for="payment_type" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Expected Payment Type</label>
                    <select
                      name="payment_type"
                      id="payment_type"
                      class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition text-sm text-slate-900 bg-slate-50 focus:bg-white"
                    >
                      <option value="Medicaid">Medicaid Insurance</option>
                      <option value="Private Pay">Private Pay</option>
                      <option value="Unsure">Unsure / Need Verification</option>
                    </select>
                  </div>
                </div>

                <div class="mb-6">
                  <label for="notes" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Care Details & Requests</label>
                  <textarea
                    name="notes"
                    id="notes"
                    rows="4"
                    placeholder="Tell us about the client's preferred schedule or specific daily requirements..."
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition text-sm text-slate-900 bg-slate-50 focus:bg-white"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-4 rounded-xl text-sm transition shadow-md hover:shadow-lg"
                >
                  Submit Care Request
                </button>
              </form>
            </div>

          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div>
          <p class="font-bold text-slate-900 text-sm">Serenitii Loving Homecare LLC</p>
          <p>Providing non-medical care state wide in Indiana.</p>
        </div>
        <div class="flex items-center gap-6">
          <a href="tel:3177961078" class="hover:text-slate-900 transition">(317) 796-1078</a>
          <a href="mailto:SerenitiiLovingHomecare@yahoo.com" class="hover:text-slate-900 transition">SerenitiiLovingHomecare@yahoo.com</a>
        </div>
        <p>&copy; {new Date().getFullYear()} Serenitii Loving Homecare LLC.</p>
      </div>
    </footer>

  </body>
</html>
