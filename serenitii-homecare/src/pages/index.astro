---
import '../styles/global.css';

// Serenitii Loving Homecare LLC - Tier 01 Local Landing Page
const FORMSPREE_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "HomeHealthService",
  "name": "Serenitii Loving Homecare LLC",
  "telephone": "+1-317-796-1078",
  "email": "SerenitiiLovingHomecare@yahoo.com",
  "description": "Statewide non-medical home care in Indiana offering ADLs, structured family caregiver compensation, meal prep, medication reminders, and gait belt transfers. Serving Evansville and Indianapolis.",
  "areaServed": [
    { "@type": "City", "name": "Indianapolis" },
    { "@type": "City", "name": "Evansville" },
    { "@type": "State", "name": "Indiana" }
  ],
  "paymentAccepted": ["Medicaid", "Private Pay", "Cash", "Credit Card"],
  "priceRange": "$$"
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Serenitii Loving Homecare LLC | Non-Medical Home Care Indiana</title>
    <meta
      name="description"
      content="Compassionate, non-medical in-home care in Indianapolis and Evansville. Personal care, ADLs, caregiver pay programs, and Medicaid waiver support."
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }

      /* Glassmorphism 2.0 layered depth */
      .glass-surface {
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 20px 40px -15px rgba(44, 39, 36, 0.05);
      }

      .glass-surface-warm {
        background: rgba(250, 246, 240, 0.78);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(235, 226, 215, 0.8);
      }

      /* Tactile spring transitions */
      .btn-tactile {
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .btn-tactile:hover {
        transform: translateY(-2px);
      }
      .btn-tactile:active {
        transform: translateY(1px) scale(0.98);
      }
    </style>
  </head>
  <body class="bg-[#FAF7F2] text-[#2C2724] antialiased selection:bg-[#E8DCC4] selection:text-[#1E1B18]">

    <!-- Utility Bar -->
    <div class="bg-[#1E1B18] text-[#E8DCC4] text-xs py-2.5 px-4 border-b border-[#2C2724]">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-medium text-[#DCD1C4]">Intake Office Active: Mon–Fri 8AM–6PM EST • 24/7 Care Dispatch</span>
        </div>
        <div class="flex items-center gap-4 text-xs">
          <span>Accepting Medicaid & Private Pay</span>
          <span class="text-stone-600">|</span>
          <a href="tel:3177961078" class="font-bold text-amber-200 hover:text-white transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
            </svg>
            (317) 796-1078
          </a>
        </div>
      </div>
    </div>

    <!-- Sticky Navigation -->
    <header class="sticky top-0 z-40 bg-[#FAF7F2]/90 backdrop-blur-md border-b border-[#E8E1D7]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
        <div>
          <a href="#" class="block group">
            <span class="font-serif font-bold text-2xl tracking-tight text-[#1E1B18] group-hover:text-amber-900 transition">
              Serenitii Loving
            </span>
            <span class="block text-[11px] font-semibold uppercase tracking-[0.2em] text-[#8C6D58] -mt-1">
              Homecare LLC
            </span>
          </a>
        </div>

        <nav class="hidden md:flex items-center space-x-8 font-medium text-sm text-[#5C534D]">
          <a href="#services" class="hover:text-[#1E1B18] transition">Services</a>
          <a href="#family-program" class="hover:text-[#1E1B18] transition">Family Caregiver Pay</a>
          <a href="#how-it-works" class="hover:text-[#1E1B18] transition">Intake Process</a>
          <a href="#coverage" class="hover:text-[#1E1B18] transition">Coverage</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="tel:3177961078"
            class="hidden sm:inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#1E1B18] bg-[#EFE9DF] hover:bg-[#E5DDCF] px-3.5 py-2.5 rounded-xl border border-[#DCD1C4] btn-tactile"
          >
            Call 317-796-1078
          </a>
          <a
            href="#contact"
            class="inline-block bg-[#1E1B18] hover:bg-[#2F2A25] text-[#FAF7F2] text-xs font-bold uppercase tracking-wider px-5 py-3 rounded-xl shadow-md btn-tactile"
          >
            Book Intake
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="relative pt-12 pb-20 md:py-24 overflow-hidden">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="grid lg:grid-cols-12 gap-12 items-center">
            
            <div class="lg:col-span-7">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EFE7DC] border border-[#DDD2C2] text-[#6D5343] text-xs font-semibold mb-6">
                <span class="w-2 h-2 rounded-full bg-[#8C6D58]"></span>
                Providing Non-Medical Care State Wide in Indiana
              </div>

              <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-serif font-bold text-[#1E1B18] leading-[1.12] mb-6">
                Dignified, attentive care inside the comfort of home.
              </h1>

              <p class="text-lg text-[#5C534D] mb-8 max-w-xl leading-relaxed">
                From essential Activities of Daily Living (ADLs) and transfer assistance to structured family caregiver support, we match vetted personnel to your home routine with zero bureaucracy.
              </p>

              <!-- Coverage Badges -->
              <div class="flex flex-wrap items-center gap-3 mb-8">
                <span class="text-xs font-bold uppercase tracking-widest text-[#8C6D58]">Coverage Accepted:</span>
                <span class="inline-block px-3 py-1.5 bg-white border border-[#DDD2C2] text-[#2C2724] text-xs font-semibold rounded-lg shadow-sm">
                  ✓ Medicaid Insurance
                </span>
                <span class="inline-block px-3 py-1.5 bg-white border border-[#DDD2C2] text-[#2C2724] text-xs font-semibold rounded-lg shadow-sm">
                  ✓ Private Pay Arrangements
                </span>
                <span class="inline-block px-3 py-1.5 bg-white border border-[#DDD2C2] text-[#2C2724] text-xs font-semibold rounded-lg shadow-sm">
                  ✓ Family Caregiver Program
                </span>
              </div>

              <!-- CTA Cluster -->
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <a
                  href="#contact"
                  class="text-center bg-[#1E1B18] text-[#FAF7F2] font-semibold px-7 py-4 rounded-xl shadow-md hover:bg-[#2F2A25] btn-tactile text-sm"
                >
                  Schedule an In-Home Assessment
                </a>
                <a
                  href="tel:3177961078"
                  class="text-center bg-white text-[#1E1B18] border border-[#DDD2C2] font-semibold px-6 py-4 rounded-xl hover:bg-[#F5EFEB] btn-tactile text-sm shadow-sm"
                >
                  Direct Phone: (317) 796-1078
                </a>
              </div>
            </div>

            <!-- Hero Photography Container -->
            <div class="lg:col-span-5 relative">
              <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-[#DDD2C2] group">
                <img
                  src="https://bzoecare.com/wp-content/uploads/2026/07/professional-in-home-caregiver-assisting.png"
                  alt="Caregiver assisting senior with care in a warm home"
                  class="w-full h-[460px] object-cover object-center group-hover:scale-105 transition duration-700 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#1E1B18]/70 via-transparent to-transparent"></div>

                <div class="absolute bottom-5 left-5 right-5 p-5 rounded-2xl glass-surface-warm border border-white/40 shadow-lg">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-xs font-bold uppercase tracking-wider text-[#8C6D58]">Daily Availability</p>
                      <p class="font-serif font-bold text-base text-[#1E1B18]">Indianapolis & Evansville Hubs</p>
                    </div>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold">
                      Open Intake
                    </span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Trust Infrastructure Bar -->
      <section class="py-8 bg-[#F3ECE1] border-y border-[#E2D8C9]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-white border border-[#DCD1C4] flex items-center justify-center text-[#8C6D58] shadow-sm flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#1E1B18]">State Vetted</p>
                <p class="text-[11px] text-[#6D635C]">Background cleared personnel</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-white border border-[#DCD1C4] flex items-center justify-center text-[#8C6D58] shadow-sm flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#1E1B18]">CPR Certified</p>
                <p class="text-[11px] text-[#6D635C]">Trained emergency readiness</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-white border border-[#DCD1C4] flex items-center justify-center text-[#8C6D58] shadow-sm flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#1E1B18]">Family Paid Care</p>
                <p class="text-[11px] text-[#6D635C]">Support for family providers</p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-white border border-[#DCD1C4] flex items-center justify-center text-[#8C6D58] shadow-sm flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#1E1B18]">Zero Friction</p>
                <p class="text-[11px] text-[#6D635C]">Medicaid waiver assistance</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Granular Service Matrix -->
      <section id="services" class="py-20 bg-white border-b border-[#E8E1D7]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div class="max-w-xl">
              <span class="text-xs font-bold uppercase tracking-widest text-[#8C6D58] mb-2 block">Granular Service Catalog</span>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#1E1B18]">
                Daily non-medical care adapted to individual mobility and health needs.
              </h2>
            </div>
            <p class="text-sm text-[#6D635C] max-w-sm">
              Custom-matched care plans designed to keep clients safe and self-sufficient in their own homes.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Service 1 -->
            <div class="p-7 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] hover:border-[#8C6D58]/40 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-[#EFE7DC] text-[#6D5343] flex items-center justify-center mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <h3 class="font-serif text-xl font-bold text-[#1E1B18] mb-2">Activities of Daily Living (ADLs)</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  Support with essential routines including morning grooming, dressing, physical stability, and personal hygiene maintained with high dignity.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-[#E8E1D7] flex items-center justify-between text-xs text-[#8C6D58] font-semibold">
                <span>Daily Assistance</span>
                <span>Personal Care</span>
              </div>
            </div>

            <!-- Service 2 -->
            <div class="p-7 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] hover:border-[#8C6D58]/40 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-[#EFE7DC] text-[#6D5343] flex items-center justify-center mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <h3 class="font-serif text-xl font-bold text-[#1E1B18] mb-2">Transfer Assistance (Gait Belt)</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  Safe physical transfers between beds, recliners, and wheelchairs using gait belts and proper ergonomic movement techniques to prevent household falls.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-[#E8E1D7] flex items-center justify-between text-xs text-[#8C6D58] font-semibold">
                <span>Fall Prevention</span>
                <span>Mobility Support</span>
              </div>
            </div>

            <!-- Service 3 -->
            <div class="p-7 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] hover:border-[#8C6D58]/40 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-[#EFE7DC] text-[#6D5343] flex items-center justify-center mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                </div>
                <h3 class="font-serif text-xl font-bold text-[#1E1B18] mb-2">Meal Preparation & Diet</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  Fresh, balanced meal preparation coordinated to dietary restrictions, diabetes management, and doctor-prescribed meal times.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-[#E8E1D7] flex items-center justify-between text-xs text-[#8C6D58] font-semibold">
                <span>Nutrition & Health</span>
                <span>Dietary Oversight</span>
              </div>
            </div>

            <!-- Service 4 -->
            <div class="p-7 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] hover:border-[#8C6D58]/40 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-[#EFE7DC] text-[#6D5343] flex items-center justify-center mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <h3 class="font-serif text-xl font-bold text-[#1E1B18] mb-2">Medication Reminders</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  Reliable schedules and prompt verbal reminders ensuring essential daily prescriptions and vitamins are taken accurately and never missed.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-[#E8E1D7] flex items-center justify-between text-xs text-[#8C6D58] font-semibold">
                <span>Prescription Adherence</span>
                <span>Routine Timing</span>
              </div>
            </div>

            <!-- Service 5 -->
            <div class="p-7 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] hover:border-[#8C6D58]/40 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-[#EFE7DC] text-[#6D5343] flex items-center justify-center mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                  </svg>
                </div>
                <h3 class="font-serif text-xl font-bold text-[#1E1B18] mb-2">Light Housekeeping & Errands</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  Dishes, bed linens, grocery shopping, prescription pickups, and local transportation to doctor appointments across Marion and Vanderburgh counties.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-[#E8E1D7] flex items-center justify-between text-xs text-[#8C6D58] font-semibold">
                <span>Clean Living Environment</span>
                <span>Errands & Rides</span>
              </div>
            </div>

            <!-- Service 6 -->
            <div class="p-7 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] hover:border-[#8C6D58]/40 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-[#EFE7DC] text-[#6D5343] flex items-center justify-center mb-6">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                </div>
                <h3 class="font-serif text-xl font-bold text-[#1E1B18] mb-2">Bathing, Toileting & Companion Care</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  Attentive bathing assistance, dignified toileting routines, and genuine companion conversation to relieve caregiver burnout and isolation.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-[#E8E1D7] flex items-center justify-between text-xs text-[#8C6D58] font-semibold">
                <span>Bathing Assistance</span>
                <span>Toileting Support</span>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Specialized Module: Get Paid to Take Care of Loved Ones -->
      <section id="family-program" class="py-20 bg-[#F3ECE1] border-b border-[#E2D8C9] relative overflow-hidden">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
          <div class="grid lg:grid-cols-12 gap-12 items-center">
            
            <div class="lg:col-span-6">
              <span class="inline-block px-3 py-1 rounded-md bg-[#8C6D58] text-[#FAF7F2] text-xs font-bold uppercase tracking-wider mb-4">
                Indiana Structured Family Caregiving
              </span>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#1E1B18] mb-6 leading-tight">
                Get paid to take care of your loved ones at home.
              </h2>
              <p class="text-base text-[#5C534D] mb-6 leading-relaxed">
                If you are currently caring for an aging parent or family member with Medicaid in Indiana, you may qualify to receive regular bi-weekly compensation as their primary dedicated caregiver.
              </p>
              
              <ul class="space-y-3 text-sm text-[#2C2724] mb-8">
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs">✓</div>
                  <span>Receive direct tax-free stipends through approved Indiana Medicaid waivers</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs">✓</div>
                  <span>Full training, coaching, and support provided by Serenitii Loving Homecare LLC</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs">✓</div>
                  <span>Maintain full control over your family member's daily home routine</span>
                </li>
              </ul>

              <a
                href="#contact"
                class="inline-block bg-[#1E1B18] hover:bg-[#2F2A25] text-[#FAF7F2] font-semibold px-7 py-3.5 rounded-xl shadow-md btn-tactile text-sm"
              >
                Check Family Eligibility
              </a>
            </div>

            <!-- Authentic Photography Showcase -->
            <div class="lg:col-span-6">
              <div class="relative rounded-3xl overflow-hidden shadow-xl border border-[#DDD2C2]">
                <img
                  src="https://homecare-aid.com/wp-content/uploads/2025/08/Meal-Preparation-for-Seniors-How-Caregivers-Can-Help-at-Home.webp"
                  alt="Caregiver and senior preparing food together in a clean home kitchen"
                  class="w-full h-[400px] object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#1E1B18]/60 to-transparent"></div>
                <div class="absolute bottom-6 left-6 right-6 text-white">
                  <p class="text-xs font-bold uppercase tracking-widest text-amber-300">Medicaid Approved Provider</p>
                  <p class="text-lg font-serif font-bold">Supporting family caregivers across Marion & Vanderburgh counties.</p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- 3-Step "How It Works" Section -->
      <section id="how-it-works" class="py-20 bg-white border-b border-[#E8E1D7]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="text-xs font-bold uppercase tracking-widest text-[#8C6D58]">Simple Intake</span>
            <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#1E1B18] mt-2">
              How Care Starts in 3 Easy Steps
            </h2>
            <p class="text-sm text-[#5C534D] mt-3">
              We eliminate healthcare red tape so your loved one receives consistent, compassionate help without delay.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <!-- Step 1 -->
            <div class="p-8 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] flex flex-col justify-between">
              <div>
                <span class="font-serif font-bold text-3xl text-[#8C6D58] block mb-4">01</span>
                <h3 class="font-bold text-lg text-[#1E1B18] mb-2">Direct Intake Call</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  Call us at 317-796-1078 or submit our form. We assess care hours, location, and verify your Medicaid or private pay setup.
                </p>
              </div>
              <span class="mt-6 text-xs font-bold text-[#8C6D58] uppercase">15-Minute Review</span>
            </div>

            <!-- Step 2 -->
            <div class="p-8 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] flex flex-col justify-between">
              <div>
                <span class="font-serif font-bold text-3xl text-[#8C6D58] block mb-4">02</span>
                <h3 class="font-bold text-lg text-[#1E1B18] mb-2">Custom Care Plan</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  We schedule an assessment to outline exact daily routines: gait belt transfers, meal schedules, medication times, and hygiene preferences.
                </p>
              </div>
              <span class="mt-6 text-xs font-bold text-[#8C6D58] uppercase">Personalized Schedule</span>
            </div>

            <!-- Step 3 -->
            <div class="p-8 rounded-3xl bg-[#FAF7F2] border border-[#E8E1D7] flex flex-col justify-between">
              <div>
                <span class="font-serif font-bold text-3xl text-[#8C6D58] block mb-4">03</span>
                <h3 class="font-bold text-lg text-[#1E1B18] mb-2">Dedicated Placement</h3>
                <p class="text-sm text-[#5C534D] leading-relaxed">
                  We introduce your trained caregiver or onboard your family caregiver, beginning care with structured check-ins from our team.
                </p>
              </div>
              <span class="mt-6 text-xs font-bold text-[#8C6D58] uppercase">Ongoing Oversight</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Coverage & Regional Authority -->
      <section id="coverage" class="py-20 bg-[#1E1B18] text-[#FAF7F2]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="grid lg:grid-cols-12 gap-12 items-center">
            
            <div class="lg:col-span-6">
              <span class="text-xs font-bold uppercase tracking-widest text-amber-300 block mb-2">Service Reach</span>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold mb-6">
                Active in Indianapolis, Evansville, and communities statewide.
              </h2>
              <p class="text-stone-300 text-sm leading-relaxed mb-8">
                Our care coordinators dispatch across Central and Southern Indiana. Whether you require morning assistance with grooming or full daytime companion supervision, we are ready to assist.
              </p>

              <div class="grid grid-cols-2 gap-4">
                <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
                  <span class="font-serif text-xl font-bold block mb-1 text-amber-200">Indianapolis</span>
                  <span class="text-xs text-stone-400">Marion, Hamilton, Hendricks, Johnson counties</span>
                </div>
                <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
                  <span class="font-serif text-xl font-bold block mb-1 text-amber-200">Evansville</span>
                  <span class="text-xs text-stone-400">Vanderburgh, Warrick & Southwest Indiana</span>
                </div>
              </div>
            </div>

            <!-- Photographic Proof Container -->
            <div class="lg:col-span-6">
              <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
                <img
                  src="https://img.freepik.com/premium-photo/portrait-smile-wheelchair-senior-couple-with-caregiver-nursing-home-disability-rehabilitation-healthcare-elderly-care-retirement-old-woman-man-with-nurse-living-room_590464-157332.jpg"
                  alt="Senior couple smiling happily with an attentive caregiver indoors"
                  class="w-full h-[360px] object-cover"
                />
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Intake & Contact Section -->
      <section id="contact" class="py-20 md:py-28 bg-[#FAF7F2]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <div class="grid lg:grid-cols-12 gap-12">
            
            <div class="lg:col-span-5">
              <span class="text-xs font-bold uppercase tracking-widest text-[#8C6D58] block mb-2">Connect Directly</span>
              <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#1E1B18] mb-6">
                Let's arrange care for your family.
              </h2>
              <p class="text-sm text-[#5C534D] mb-8 leading-relaxed">
                Reach out by phone or submit the intake form. Inquiries are reviewed within hours by our care coordinators.
              </p>

              <div class="space-y-6">
                <!-- Phone -->
                <div class="flex items-start gap-4">
                  <div class="w-11 h-11 rounded-xl bg-white border border-[#DCD1C4] flex items-center justify-center text-[#8C6D58] shadow-sm flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Phone</p>
                    <a href="tel:3177961078" class="text-lg font-bold text-[#1E1B18] hover:text-[#8C6D58] transition">
                      (317) 796-1078
                    </a>
                  </div>
                </div>

                <!-- Email -->
                <div class="flex items-start gap-4">
                  <div class="w-11 h-11 rounded-xl bg-white border border-[#DCD1C4] flex items-center justify-center text-[#8C6D58] shadow-sm flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Email</p>
                    <a href="mailto:SerenitiiLovingHomecare@yahoo.com" class="text-sm font-bold text-[#1E1B18] hover:text-[#8C6D58] transition break-all">
                      SerenitiiLovingHomecare@yahoo.com
                    </a>
                  </div>
                </div>

                <!-- Service Hubs -->
                <div class="flex items-start gap-4">
                  <div class="w-11 h-11 rounded-xl bg-white border border-[#DCD1C4] flex items-center justify-center text-[#8C6D58] shadow-sm flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Operational Areas</p>
                    <p class="text-base font-bold text-[#1E1B18]">Evansville & Indianapolis, Indiana</p>
                    <p class="text-xs text-[#8C6D58]">Serving families statewide</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Glassmorphic Form Card -->
            <div class="lg:col-span-7">
              <form
                action={FORMSPREE_ENDPOINT}
                method="POST"
                class="glass-surface p-8 sm:p-10 rounded-3xl border border-white/60 shadow-xl"
              >
                <h3 class="text-xl font-bold text-[#1E1B18] mb-6 font-serif">Inquiry & Intake Form</h3>

                <div class="grid sm:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label for="name" class="block text-xs font-bold uppercase tracking-wider text-[#4A423D] mb-1.5">Your Full Name *</label>
                    <input
                      type="text"
                      name="name"
                      id="name"
                      required
                      placeholder="Jane Doe"
                      class="w-full px-4 py-3 rounded-xl border border-[#DCD1C4] focus:ring-2 focus:ring-[#1E1B18] focus:border-transparent outline-none transition text-sm text-[#1E1B18] bg-white"
                    />
                  </div>
                  <div>
                    <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-[#4A423D] mb-1.5">Phone Number *</label>
                    <input
                      type="tel"
                      name="phone"
                      id="phone"
                      required
                      placeholder="(317) 000-0000"
                      class="w-full px-4 py-3 rounded-xl border border-[#DCD1C4] focus:ring-2 focus:ring-[#1E1B18] focus:border-transparent outline-none transition text-sm text-[#1E1B18] bg-white"
                    />
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label for="email" class="block text-xs font-bold uppercase tracking-wider text-[#4A423D] mb-1.5">Email Address</label>
                    <input
                      type="email"
                      name="email"
                      id="email"
                      placeholder="name@email.com"
                      class="w-full px-4 py-3 rounded-xl border border-[#DCD1C4] focus:ring-2 focus:ring-[#1E1B18] focus:border-transparent outline-none transition text-sm text-[#1E1B18] bg-white"
                    />
                  </div>
                  <div>
                    <label for="location" class="block text-xs font-bold uppercase tracking-wider text-[#4A423D] mb-1.5">City or Indiana County</label>
                    <input
                      type="text"
                      name="location"
                      id="location"
                      placeholder="e.g. Evansville or Indianapolis"
                      class="w-full px-4 py-3 rounded-xl border border-[#DCD1C4] focus:ring-2 focus:ring-[#1E1B18] focus:border-transparent outline-none transition text-sm text-[#1E1B18] bg-white"
                    />
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label for="service_needed" class="block text-xs font-bold uppercase tracking-wider text-[#4A423D] mb-1.5">Primary Care Needed</label>
                    <select
                      name="service_needed"
                      id="service_needed"
                      class="w-full px-4 py-3 rounded-xl border border-[#DCD1C4] focus:ring-2 focus:ring-[#1E1B18] focus:border-transparent outline-none transition text-sm text-[#1E1B18] bg-white"
                    >
                      <option value="Activities of Daily Living (ADLs)">Activities of Daily Living (ADLs)</option>
                      <option value="Family Caregiver Pay Program">Family Caregiver Pay Program</option>
                      <option value="Gait Belt Transfer Assistance">Transfer Assistance (Gait Belt)</option>
                      <option value="Meal Preparation">Meal Preparation</option>
                      <option value="Medication Reminders">Medication Reminders</option>
                      <option value="Light Housekeeping / Errands">Light Housekeeping & Errands</option>
                      <option value="Bathing & Toileting Assistance">Bathing & Toileting Assistance</option>
                      <option value="Multiple Services">Multiple Services / General Assessment</option>
                    </select>
                  </div>
                  <div>
                    <label for="coverage_type" class="block text-xs font-bold uppercase tracking-wider text-[#4A423D] mb-1.5">Payment Method</label>
                    <select
                      name="coverage_type"
                      id="coverage_type"
                      class="w-full px-4 py-3 rounded-xl border border-[#DCD1C4] focus:ring-2 focus:ring-[#1E1B18] focus:border-transparent outline-none transition text-sm text-[#1E1B18] bg-white"
                    >
                      <option value="Medicaid">Medicaid Insurance</option>
                      <option value="Private Pay">Private Pay</option>
                      <option value="Unsure">Unsure / Need Program Check</option>
                    </select>
                  </div>
                </div>

                <div class="mb-6">
                  <label for="notes" class="block text-xs font-bold uppercase tracking-wider text-[#4A423D] mb-1.5">Care Details & Requests</label>
                  <textarea
                    name="notes"
                    id="notes"
                    rows="4"
                    placeholder="Tell us about daily routines, preferred caregiver schedules, or whether you want to get enrolled as a paid family caregiver..."
                    class="w-full px-4 py-3 rounded-xl border border-[#DCD1C4] focus:ring-2 focus:ring-[#1E1B18] focus:border-transparent outline-none transition text-sm text-[#1E1B18] bg-white"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full bg-[#1E1B18] hover:bg-[#2F2A25] text-[#FAF7F2] font-bold py-4 rounded-xl text-sm transition shadow-md hover:shadow-lg btn-tactile"
                >
                  Send Intake Request
                </button>
              </form>
            </div>

          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-[#E8E1D7] py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-stone-500">
        <div>
          <p class="font-serif font-bold text-[#1E1B18] text-base">Serenitii Loving Homecare LLC</p>
          <p class="text-stone-600">Providing non-medical care state wide in Indiana.</p>
        </div>
        <div class="flex items-center gap-6 font-medium">
          <a href="tel:3177961078" class="text-[#1E1B18] hover:text-[#8C6D58] transition">(317) 796-1078</a>
          <a href="mailto:SerenitiiLovingHomecare@yahoo.com" class="text-[#1E1B18] hover:text-[#8C6D58] transition">SerenitiiLovingHomecare@yahoo.com</a>
        </div>
        <p>&copy; {new Date().getFullYear()} Serenitii Loving Homecare LLC. All rights reserved.</p>
      </div>
    </footer>

  </body>
</html>
