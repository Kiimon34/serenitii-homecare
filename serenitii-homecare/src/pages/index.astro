    <meta
      name="description"
      content="Statewide Indiana non-medical home care. Experienced caregivers providing personal care, companionship, meal prep, and medication reminders. Private pay & Medicaid accepted."
    />

    <!-- Indiana Local Business Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }
    </style>
  </head>
  <body class="bg-[#FAF9F6] text-slate-800 antialiased selection:bg-amber-100 selection:text-amber-900">

